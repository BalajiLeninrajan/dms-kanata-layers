{
    "id": "kanataLayers",
    "name": "Kanata Layers",
    "description": "Shows the active kanata layer in the bar and pops up its keymap while the layer is held",
    "version": "0.1.0",
    "license": "MIT",
    "author": "Balaji Leninrajan",
    "icon": "keyboard",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget"],
    "components": {
        "daemon": "./KanataDaemon.qml",
        "widget": "./KanataWidget.qml"
    },
    "settings": "./KanataSettings.qml",
    "requires_dms": ">=1.5.0",
    "requires": ["kanata", "bash"],
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
